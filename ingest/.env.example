# Supabase -> Project -> Connect -> "Connection string" -> URI tab.
#
# Use the SESSION POOLER (port 5432) URI, not the transaction pooler (6543):
# the transaction pooler does not support prepared statements or advisory locks,
# both of which the loader uses. Direct connection also works.
#
# Looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres
PMS_DATABASE_URL=

# Raw HTML snapshots are written here, NOT into Postgres. A full SEBI backfill is
# ~10 GB of HTML; the free tier gives you 500 MB of database.
PMS_RAW_DIR=ingest/raw

# Politeness. APMI serves no robots.txt; SEBI's allows everything but /js and /css.
PMS_REQUEST_DELAY_SEC=2.0
PMS_MAX_RETRIES=4
PMS_USER_AGENT=bunker-o-billionaire-ingest/0.1 (+contact: ujjawal.chhajer@hilabs.com)

# Only needed where the system resolver cannot look a source up. Some corporate
# and VPN resolvers answer SERVFAIL for sebi.gov.in, which is indistinguishable
# from the site being down. Set a public resolver and failed lookups -- only
# those -- are retried against it. Leave empty to keep system DNS alone.
PMS_DNS_FALLBACK=
