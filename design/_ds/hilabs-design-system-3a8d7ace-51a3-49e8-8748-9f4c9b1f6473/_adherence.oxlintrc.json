{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/layout/**",
              "slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Satoshi))/i]",
        "message": "Font not provided by the design system. Available: Satoshi."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:side|width|height|color|style|key|ref|className|style|children)$/]",
        "message": "<AccentTab> doesn't accept that prop. Declared props: side, width, height, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccentTab'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right|top|bottom)$/]",
        "message": "<AccentTab> side must be one of 'left' | 'right' | 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|shape|uppercase|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, shape, uppercase, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:good|warn|bad|info|neutral|solid|dark)$/]",
        "message": "<Badge> tone must be one of 'good' | 'warn' | 'bad' | 'info' | 'neutral' | 'solid' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:pill|square)$/]",
        "message": "<Badge> shape must be one of 'pill' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandGlyph'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|assetBase|style|key|ref|className|style|children)$/]",
        "message": "<BrandGlyph> doesn't accept that prop. Declared props: name, size, color, assetBase, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandGlyph'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:flow|burst|layers|columns|stream|bars)$/]",
        "message": "<BrandGlyph> name must be one of 'flow' | 'burst' | 'layers' | 'columns' | 'stream' | 'bars'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|dark|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'dark' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|children|style|key|ref|className|style|children)$/]",
        "message": "<Callout> doesn't accept that prop. Declared props: tone, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Callout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|good|warn|bad|dark)$/]",
        "message": "<Callout> tone must be one of 'info' | 'good' | 'warn' | 'bad' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|accent|eyebrow|title|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, accent, eyebrow, title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|outlined|tinted|dark)$/]",
        "message": "<Card> tone must be one of 'plain' | 'outlined' | 'tinted' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|header|align|key|ref|className|style|children)$/]",
        "message": "<DataTableColumn> doesn't accept that prop. Declared props: key, header, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTableColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<DataTableColumn> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|label|key|ref|className|style|children)$/]",
        "message": "<LegendItem> doesn't accept that prop. Declared props: color, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|assetBase|color|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, size, assetBase, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:color|white|mono)$/]",
        "message": "<Logo> variant must be one of 'color' | 'white' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberedListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|meta|key|ref|className|style|children)$/]",
        "message": "<NumberedListItem> doesn't accept that prop. Declared props: label, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|end|label|color|textColor|key|ref|className|style|children)$/]",
        "message": "<PhaseBar> doesn't accept that prop. Declared props: start, end, label, color, textColor."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|label|valueLabel|tone|height|showTrack|style|key|ref|className|style|children)$/]",
        "message": "<ProgressMeter> doesn't accept that prop. Declared props: value, max, label, valueLabel, tone, height, showTrack, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressMeter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|navy|good|warn)$/]",
        "message": "<ProgressMeter> tone must be one of 'blue' | 'navy' | 'good' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|align|uppercase|children|style|key|ref|className|style|children)$/]",
        "message": "<SectionBand> doesn't accept that prop. Declared props: tone, align, uppercase, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|black|blue|light)$/]",
        "message": "<SectionBand> tone must be one of 'dark' | 'black' | 'blue' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionBand'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionBand> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|caption|tone|size|align|style|key|ref|className|style|children)$/]",
        "message": "<StatCallout> doesn't accept that prop. Declared props: value, label, caption, tone, size, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|navy|good|bad|solid|inverse)$/]",
        "message": "<StatCallout> tone must be one of 'blue' | 'navy' | 'good' | 'bad' | 'solid' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatCallout> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCallout'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<StatCallout> align must be one of 'left' | 'center' | 'right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
